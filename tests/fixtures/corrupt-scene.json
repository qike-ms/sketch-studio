{
  "version": 1,
  "elements": [
    { "id": "good", "type": "rect", "x": 10, "y": 10, "width": 100, "height": 80, "unknownField": 1 },
    { "id": "good", "type": "ellipse", "x": 50, "y": 50, "width": -40, "height": 20 },
    { "id": "nan", "type": "rect", "x": "nope", "y": null, "width": 1e999, "height": -1e999, "strokeWidth": "fat" },
    { "id": "weird", "type": "triangle", "x": 0, "y": 0, "width": 10, "height": 10 },
    { "id": "dangling", "type": "arrow", "x": 0, "y": 0, "points": [{ "x": 0, "y": 0 }, { "x": 50, "y": 0 }],
      "startBinding": { "elementId": "ghost" }, "endBinding": { "elementId": "dangling" } },
    { "id": "orphan-text", "type": "text", "text": "orphan", "x": 0, "y": 0, "width": 20, "height": 10,
      "containerId": "ghost" },
    { "id": "bad-color", "type": "rect", "x": 0, "y": 0, "width": 20, "height": 20,
      "strokeColor": "url(javascript:alert(1))", "backgroundColor": "#ff0000", "opacity": 400 },
    { "id": "bad-points", "type": "freehand", "x": 0, "y": 0,
      "points": [{ "x": 0, "y": 0 }, { "x": "NaN", "y": 4 }, null] },
    { "id": "image", "type": "image", "x": 0, "y": 0, "width": 10, "height": 10,
      "imageSrc": "https://example.com/tracker.png" }
  ]
}
